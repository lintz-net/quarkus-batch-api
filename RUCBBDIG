                  (WS-NUMERO(05) * 05) +
                  (WS-NUMERO(06) * 04) +
                  (WS-NUMERO(07) * 03) +
                  (WS-NUMERO(08) * 02) +
                  (WS-NUMERO(09) * 09) +
                  (WS-NUMERO(10) * 08) +
                  (WS-NUMERO(11) * 07) +
                  (WS-NUMERO(12) * 06) +
                  (WS-NUMERO(13) * 05) +
                  (WS-NUMERO(14) * 04) +
                  (WS-NUMERO(15) * 03) +
                  (WS-NUMERO(16) * 02)).
      *
           DIVIDE  WS-SOMA     BY   11
                   GIVING      TALLY
                   REMAINDER   WS-RESTO.
      *
           IF   WS-RESTO   LESS   2
             MOVE   ZEROS   TO   WS-DIGITO-1
           ELSE
             COMPUTE   WS-DIGITO-1   =   11   -   WS-RESTO
           END-IF.
      *
           COMPUTE WS-SOMA =
                 ((WS-NUMERO(01) * 02) +
                  (WS-NUMERO(02) * 09) +
                  (WS-NUMERO(03) * 08) +
                  (WS-NUMERO(04) * 07) +
                  (WS-NUMERO(05) * 06) +
                  (WS-NUMERO(06) * 05) +
                  (WS-NUMERO(07) * 04) +
                  (WS-NUMERO(08) * 03) +
                  (WS-NUMERO(09) * 02) +
                  (WS-NUMERO(10) * 09) +
                  (WS-NUMERO(11) * 08) +
                  (WS-NUMERO(12) * 07) +
                  (WS-NUMERO(13) * 06) +
                  (WS-NUMERO(14) * 05) +
                  (WS-NUMERO(15) * 04) +
                  (WS-NUMERO(16) * 03) +
                  (WS-DIGITO-1   * 02)).
      *
           DIVIDE  WS-SOMA     BY    11
                   GIVING      TALLY
                   REMAINDER   WS-RESTO.
      *
           IF   WS-RESTO   LESS   2
             MOVE   ZEROS   TO  WS-DIGITO-2
           ELSE
             COMPUTE   WS-DIGITO-2   =   11   -   WS-RESTO
