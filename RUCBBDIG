              ( WS-DIG-LONGO(08) EQUAL ZEROS ) AND
              ( WS-DIG-LONGO(09) EQUAL ZEROS ) AND
              ( WS-DIG-LONGO(15) EQUAL ZEROS ) AND
              ( WS-DIG-LONGO(16) EQUAL ZEROS ) AND
              ( WS-DIG-LONGO(17) EQUAL ZEROS ) AND
              ( WS-DIG-LONGO(18) EQUAL ZEROS )
              MOVE   4   TO   WS-IND-PESO
           ELSE
             IF ( WS-DIG-LONGO(07) EQUAL ZEROS ) AND
                ( WS-DIG-LONGO(08) EQUAL ZEROS ) AND
                ( WS-DIG-LONGO(09) EQUAL ZEROS )
                MOVE   3   TO   WS-IND-PESO
             ELSE
               IF ( WS-DIG-LONGO(15) EQUAL ZEROS ) AND
                  ( WS-DIG-LONGO(16) EQUAL ZEROS ) AND
                  ( WS-DIG-LONGO(17) EQUAL ZEROS ) AND
                  ( WS-DIG-LONGO(18) EQUAL ZEROS )
                  MOVE   2   TO   WS-IND-PESO
               ELSE
                  MOVE   1   TO   WS-IND-PESO
               END-IF
             END-IF
           END-IF.
